# GitHub token used on the server to read public repositories (ARCHITECTURE.md §10).
# A fine-grained personal access token with no extra permissions is enough:
# https://github.com/settings/personal-access-tokens/new
# Copy this file to .env.local and fill it in; .env.local is not committed.
GITHUB_TOKEN=

# Optional: another GraphQL endpoint, for GitHub Enterprise or a local mock server.
GITHUB_GRAPHQL_URL=
